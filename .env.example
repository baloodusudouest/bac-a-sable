# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis maison (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun (déjà dans la stack). Sert à l'Anneau (sauvegarde des réglages) et à la copie depuis carnet.
MAISON_JETON=
# Clé de lecture de l'Anneau (contrat 3) : n'ouvre que les fiches « Connexion ». Vide : l'Anneau ne les lit pas.
ANNEAU_CLE=

# Facultatif : copier de vraies fiches depuis carnet (lecture seule). Adresse vue depuis le conteneur
# (le Bac à sable n'est pas sur le réseau de la stack : adresse IP du NAS et port de carnet).
BAC_CARNET_URL=
# Facultatif : adresses de la maison à essayer à l'autotest (hôte:port, virgules), pour prouver qu'elles sont fermées
BAC_AUTOTEST=
# BAC_ARRET_MINUTES=30
# BAC_MAX_SIMULTANEES=4
